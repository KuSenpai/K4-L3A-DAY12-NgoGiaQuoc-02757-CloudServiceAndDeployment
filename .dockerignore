# File này quyết định thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret — tuyệt đối không vào image
.env
.env.*
!.env.example

# Git
.git
.gitignore
.github

# Python cache & môi trường ảo
__pycache__
*.pyc
*.pyo
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache

# Không cần lúc chạy
tests
screenshots
*.md
docker-compose.yml
nginx
.dockerignore
.vscode
.idea
